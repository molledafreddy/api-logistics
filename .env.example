# ═══════════════════════════════════════════
# .env.example — API Logistics
# ═══════════════════════════════════════════

# ─── App ──────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
APP_NAME=API-Logistics
APP_VERSION=1.0.0
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# ─── Database ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logistics_dev
DB_USER=logistics
DB_PASSWORD=logistics_dev_pass
DB_SSL=false
DB_LOGGING=true
DB_SYNCHRONIZE=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ─── JWT (legacy, optional) ───────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# ─── Supabase ─────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# JWT audience claim. Default Supabase usa 'authenticated'.
SUPABASE_JWT_AUD=authenticated

# ─── S3 / MinIO ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_BUCKET_AVATARS=logistics-avatars
S3_BUCKET_DOCUMENTS=logistics-documents
S3_BUCKET_RECEIPTS=logistics-receipts
S3_BUCKET_CHAT=logistics-chat
S3_BUCKET_EXPORTS=logistics-exports
S3_FORCE_PATH_STYLE=true

# ─── Email ────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@api-logistics.com
MAIL_FROM_NAME=API Logistics

# ─── Firebase (Push Notifications) ────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Rate Limiting (3 buckets) ────────────
# short: ráfagas (anti-bot)
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=10
# medium: por defecto
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# long: ventana amplia anti-abuso sostenido
THROTTLE_LONG_TTL=3600000
THROTTLE_LONG_LIMIT=1000

# ─── Performance / límites de payload ─────
MAX_REQUEST_BODY_SIZE=1mb
MAX_FILE_UPLOAD_SIZE=25mb

# ─── Sentry (observabilidad) ──────────────
# Dejar vacío para deshabilitar
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

# ─── Logging ──────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ─── Seeds (CLI scripts) ──────────────────
# Cambiarlos en prod a credenciales fuertes
SUPER_ADMIN_EMAIL=admin@logistics-api.com
SUPER_ADMIN_PASSWORD=SuperAdmin1!@#
# Activar a 'true' para que `pnpm seed:demo` pueble datos de demo
SEED_DEMO=false

# ─── Testing flags ────────────────────────
# Solo en .env.test → bypassea verificación real de JWT Supabase (usa HS256 stub)
E2E_TEST=false

# ─── Geocoding (Sprint C) ─────────────────
# Provider activo: 'mapbox' (requiere MAPBOX_TOKEN) | 'mock' (fixtures determinísticos)
GEOCODING_PROVIDER=mock
# Mapbox access token. Cuenta Free: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=
# País por defecto para autocomplete (ISO-3166-1 alpha-2)
GEOCODING_DEFAULT_COUNTRY=cl
# TTL del cache Redis para resultados de geocoding (segundos). Default: 24 h.
GEOCODING_CACHE_TTL_SEC=86400
# Rate limit por usuario/IP al endpoint de geocoding (req/min)
GEOCODING_RATE_LIMIT_PER_MIN=60

# ─── Mapbox Optimization (Sprint C.4) ─────
# Profile de routing: 'mapbox/driving-traffic' | 'mapbox/driving' | 'mapbox/walking' | 'mapbox/cycling'
MAPBOX_OPTIMIZATION_PROFILE=mapbox/driving-traffic
# Timeout para la llamada Mapbox Optimization v1 (ms). Excedido → fallback a Haversine.
MAPBOX_OPTIMIZATION_TIMEOUT_MS=15000

# ─── Payments / MercadoPago Chile (Sprint E) ─────
# Provider activo. 'mercadopago' requiere MERCADOPAGO_ACCESS_TOKEN; 'mock' devuelve URLs determinísticas (dev/test).
PAYMENTS_PROVIDER=mock
# Access token (panel MP → Credenciales). Dev: 'TEST-...', Prod: 'APP_USR-...'
MERCADOPAGO_ACCESS_TOKEN=
# Secret para validar firma HMAC del webhook (panel MP → Webhooks → Secret).
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública del webhook (debe ser https en prod). Configurar en panel MP.
MERCADOPAGO_NOTIFICATION_URL=
# back_urls del checkout (frontend del cliente)
MERCADOPAGO_SUCCESS_URL=http://localhost:3001/billing/success
MERCADOPAGO_FAILURE_URL=http://localhost:3001/billing/failure
MERCADOPAGO_PENDING_URL=http://localhost:3001/billing/pending
# Timeout HTTP para llamadas a la API de MP (ms)
MERCADOPAGO_TIMEOUT_MS=8000

# ─── Legacy ───────────────────────────────
# Solo si usas el script antiguo `src/seeds/seed.ts` (TypeORM CLI)
DATABASE_URL=
