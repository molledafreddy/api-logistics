# ═══════════════════════════════════════════
# .env.example — API Logistics
# ═══════════════════════════════════════════

# ─── App ──────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
APP_NAME=API-Logistics
APP_VERSION=1.0.0
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# ─── Database ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logistics_dev
DB_USER=logistics
DB_PASSWORD=logistics_dev_pass
DB_SSL=false
DB_LOGGING=true
DB_SYNCHRONIZE=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ─── JWT (legacy, optional) ───────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# ─── Supabase ─────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── S3 / MinIO ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_BUCKET_AVATARS=logistics-avatars
S3_BUCKET_DOCUMENTS=logistics-documents
S3_BUCKET_RECEIPTS=logistics-receipts
S3_BUCKET_CHAT=logistics-chat
S3_BUCKET_EXPORTS=logistics-exports
S3_FORCE_PATH_STYLE=true

# ─── Email ────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@api-logistics.com
MAIL_FROM_NAME=API Logistics

# ─── Stripe ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Firebase (Push Notifications) ────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Rate Limiting (3 buckets) ────────────
# short: ráfagas (anti-bot)
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=10
# medium: por defecto
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# long: ventana amplia anti-abuso sostenido
THROTTLE_LONG_TTL=3600000
THROTTLE_LONG_LIMIT=1000

# ─── Performance / límites de payload ─────
MAX_REQUEST_BODY_SIZE=1mb
MAX_FILE_UPLOAD_SIZE=25mb

# ─── Sentry (observabilidad) ──────────────
# Dejar vacío para deshabilitar
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

# ─── Logging ──────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty
