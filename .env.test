# ═══════════════════════════════════════════
# .env.test — API Logistics (test)
# ═══════════════════════════════════════════

NODE_ENV=test
APP_PORT=3001
APP_URL=http://localhost:3001
APP_NAME=API-Logistics-Test
APP_VERSION=1.0.0
API_PREFIX=v1
CORS_ORIGINS=*

DB_HOST=localhost
DB_PORT=5433
DB_NAME=logistics_test
DB_USER=logistics
DB_PASSWORD=logistics_test_pass
DB_SSL=false
DB_LOGGING=false
DB_SYNCHRONIZE=false
DB_POOL_MIN=1
DB_POOL_MAX=5

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=false

JWT_PRIVATE_KEY="test-private-key"
JWT_PUBLIC_KEY="test-public-key"
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_BUCKET_AVATARS=logistics-avatars-test
S3_BUCKET_DOCUMENTS=logistics-documents-test
S3_BUCKET_RECEIPTS=logistics-receipts-test
S3_BUCKET_CHAT=logistics-chat-test
S3_BUCKET_EXPORTS=logistics-exports-test
S3_FORCE_PATH_STYLE=true

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=test@api-logistics.com
MAIL_FROM_NAME=API Logistics Test

STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

THROTTLE_TTL=60000
THROTTLE_LIMIT=1000

LOG_LEVEL=error
LOG_FORMAT=json
